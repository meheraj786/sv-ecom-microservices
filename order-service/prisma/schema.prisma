generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  totalAmount    Float 
  discountAmount Float       @default(0) 
  couponCode     String? 
  status         String      @default("PENDING")
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("orders")
}

// 2. Add New Coupon Model inside order_schema
model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique 
  discountType  String 
  discountValue Float 
  minOrderValue Float    @default(0) 
  maxDiscount   Float? 
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("coupons")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}
