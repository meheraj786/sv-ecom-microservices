generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String            @id @default(cuid())
  name          String            @unique
  slug          String            @unique
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  subCategories SubCategory[]
  products      ProductCategory[]

  @@map("categories")
}

model SubCategory {
  id         String               @id @default(cuid())
  name       String
  slug       String               @unique
  image      String?
  categoryId String
  category   Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   ProductSubCategory[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String?
  basePrice      Float
  discountPrice  Float?
  sku            String               @unique
  images         String[]
  isNew          Boolean              @default(false)
  isBestSeller   Boolean              @default(false)
  isFeatured     Boolean              @default(false)
  isActive       Boolean              @default(true)
  averageRating  Float                @default(0.0)
  specifications Json?
  categories     ProductCategory[]
  subCategories  ProductSubCategory[]
  variants       ProductVariant[]
  reviews        Review[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([isActive])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSubCategory {
  id            String      @id @default(cuid())
  productId     String
  subCategoryId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, subCategoryId])
  @@index([subCategoryId])
  @@map("product_subcategories")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  color             String?
  size              String?
  price             Float?
  images            String[]
  quantityRemaining Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([quantityRemaining])
  @@map("product_variants")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  totalAmount    Float
  discountAmount Float         @default(0)
  couponCode     String?
  status         String        @default("PENDING")
  items          OrderItem[]
  couponUsages   CouponUsage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Coupon {
  id            String           @id @default(cuid())
  code          String           @unique
  discountType  String
  discountValue Float
  minOrderValue Float            @default(0)
  maxDiscount   Float?
  startsAt      DateTime?
  expiresAt     DateTime
  usageLimit    Int?
  usedCount     Int              @default(0)
  perUserLimit  Int?
  scope         String           @default("ALL")
  isActive      Boolean          @default(true)
  products      CouponProduct[]
  categories    CouponCategory[]
  usages        CouponUsage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponProduct {
  id        String @id @default(cuid())
  couponId  String
  productId String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model CouponCategory {
  id         String @id @default(cuid())
  couponId   String
  categoryId String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_usages")
}
